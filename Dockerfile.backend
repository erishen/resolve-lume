# syntax=docker/dockerfile:1
# resolve-lume 后端镜像。
# 构建上下文 = 本仓库根：把 agent-httpd / lume-core 两个子模块一起打进镜像，
# 运行时把它们与 souls / lume-tools / .data 打包，最终只留两个二进制 + 配置。
#
# 依赖子模块已初始化：构建前先 `git submodule update --init --recursive`
# （或用仓库根 Makefile 的 `make setup`）。

# ---------- 阶段 1: 构建 agent-httpd (C) ----------
FROM debian:bookworm-slim AS c-build
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libcrypt-dev libsqlite3-dev make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY agent-httpd/ ./agent-httpd/
RUN make -C agent-httpd all

# ---------- 阶段 2: 构建 lume-core (C) ----------
FROM debian:bookworm-slim AS core-build
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libcrypt-dev libsqlite3-dev make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY lume-core/ ./lume-core/
RUN make -C lume-core all

# ---------- 阶段 3: 运行时 (纯 C 二进制, 无需 node) ----------
# 关键瘦身: backend 运行时只 exec /usr/local/bin/agent-httpd (C) + lume-core (C),
# 由 backend-entrypoint.sh 直接拉起, 不依赖 node。ldd 证实 agent-httpd 仅依赖
# libc/libm/libsqlite3.so.0/libcrypt.so.1, lume-core 仅 libc/libm/libsqlite3.so.0。
# 因此运行时基础镜像用 debian:bookworm-slim 即可, 省掉 node:24-bookworm-slim 的
# ~242MB (97MB debian + 145MB node) 层。
# 不再装 python3/git/make/libgomp1/libmagic1, 也不再拷 uv —— 这些都是给
# "Python MCP 桥 (portfolio-check / pse-review)" 备的, resolve-lume 未接入;
# 宿主项目的 Makefile 构建由 sidecar (保留 python3 + uv) 负责, backend 不跑。
FROM debian:bookworm-slim
# curl: agent-httpd 的 LLM 上游通道 (fork curl -N 流式)
# ca-certificates: git/https 到 LLM 的根证书
# libcrypt1: lume-core -lcrypt
# libsqlite3-0: agent-httpd / lume-core -lsqlite3
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates libcrypt1 libsqlite3-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# docroot（agent-httpd 以 cwd 为根；真实前端由 nginx 托管，这里仅占位）
COPY www/ ./www/
COPY --from=c-build /build/agent-httpd/bin/agent-httpd /usr/local/bin/agent-httpd
COPY --from=core-build /build/lume-core/bin/lume-core /usr/local/bin/lume-core
COPY souls/ ./souls/
COPY lume-tools/ ./lume-tools/
COPY deploy/mcp-servers.json .data/mcp-servers.json
RUN mkdir -p /var/log/agent-httpd /run/agent-httpd
COPY deploy/backend-entrypoint.sh /usr/local/bin/backend-entrypoint
RUN chmod +x /usr/local/bin/backend-entrypoint
EXPOSE 8080
ENTRYPOINT ["backend-entrypoint"]
