};

tool "dev-stats", "Dev stats: reads/CI/clone CSV. target in [report|juejin|segmentfault|ci|actions]. Never use shell/read-file here; quote only tool output.", {"target": "string", "args": "string"}, (p) => {
  return sidecar_tool("dev-stats", stringify(p));
};

tool "hot-news", "Generate compliant social copy for a hot topic (1-5 min). req: topic. Call DIRECTLY, never read files first. Paid provider needs approval.", {"topic": "string", "news_dir": "string", "platform": "string", "category": "string", "provider": "string"}, (p) => {
  return sidecar_tool("hot-news", stringify(p));
};

tool "hot-news-fetch", "Fetch hot-news snapshots into news/ (pipeline step 1). sources is a COMMA-SEPARATED STRING like \"weibo,infoq\", NOT an array.", {"limit": "int", "max_age_days": "int", "clean": "bool", "use_proxy": "bool", "out": "string"}, (p) => {
  return sidecar_tool("hot-news-fetch", stringify(p));
};

tool "hot-news-topics", "List writable hot topics from existing news/ snapshots (read-only). Run hot-news-fetch first if empty.", {"news_dir": "string"}, (p) => {
