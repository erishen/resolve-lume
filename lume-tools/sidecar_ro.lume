};

tool "article-validate", "VALIDATE article files only - never writes/publishes. project from enum; omit to list queue. Publishing is NOT exposed to you: say so.", {"project": "string", "confirm": "bool"}, (p) => {
  return sidecar_tool("article-validate", stringify(p));
};

tool "article-write", "Write article? Call DIRECTLY with project=KEY; NEVER read files or guess paths first. Omit project to list candidates. ONE article per call.", {"project": "string", "publish": "bool", "style": "string", "provider": "string"}, (p) => {
  return sidecar_tool("article-write", stringify(p));
};

tool "skill-run", "Load a SOUL.md skill by name (planner/specialist/evaluator). article-write is a TOOL not a skill: call that tool with project=KEY.", {"name": "string", "skill": "string"}, (p) => {
