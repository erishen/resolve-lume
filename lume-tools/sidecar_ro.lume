// ⚠️ 自动生成，不要手改。生成器: deploy/gen-sidecar-tools.mjs
// 数据源: sidecar/builtin-tools.json（schema 与实现同源，所以这里只做映射）
//
// 作用: 把宿主 sidecar 的业务工具以 stdio MCP 暴露给 agent-httpd，让跑循环的 C
// 进程真的能调用它们。此前 sidecar 的 42 个工具只进前端面板 /api/tools 和手动
// /api/tool/run，agent 只能看到内置 7 + lume-tools 5 + router 代理 4，导致需要
// 真实数据面的任务必然空转（PSE FAIL 的根因）。
//
// 依赖两个环境变量（compose backend 注入）:
//   SIDECAR_TOOLS_URL  例 http://host.docker.internal:3000/api/tools/call
//   SIDECAR_TOOLS_AUTH 与 sidecar 的 SIDECAR_TOKEN 同值。刻意不叫 *_TOKEN：
//     lume 的 env() 对含 TOKEN/SECRET/API_KEY/PASSWORD 的名字返回 null
//     （builtins_fs.c:85-101 env_is_sensitive），改名才取得到。

// 所有 tool 共用这一条出站调用。工具名在各自 handler 里写死，LLM 无法把
// name 传成别的工具，因此不会把请求绕回 agent-httpd 形成回环。
func sidecar_tool(tool_name, args_json) {
  let base = env("SIDECAR_TOOLS_URL");
  if (len(base) == 0) { return "error: SIDECAR_TOOLS_URL not set (compose backend env)"; }
  let hdr = {"Content-Type": "application/json", "X-Sidecar-Token": env("SIDECAR_TOOLS_AUTH")};
  let body = "{\"name\":\"" + tool_name + "\",\"arguments\":" + args_json + "}";
  // allow_private: sidecar 在 127.0.0.1，lume 的 SSRF 闸门默认拒私有地址
  //                （builtins_http.c:25-26,901）——不加这一句调用必失败。
  // timeout 600 是 lume 的封顶；sidecar 侧 spawnCapture 自己是 300s，够用。
  let r = http_post(base, {"headers": hdr, "body": body, "timeout": 600, "max_bytes": 2097152, "allow_private": true});
  if (r["ok"] != true) { return "error: sidecar call failed: " + str(r["err"]) + " status=" + str(r["status"]); }
  // json() 解析失败会中止脚本；包 try() 才能把「上游返回非 JSON」变成可读的
  // 工具错误。try 的成功值在 ok 键、失败信息在 err 键（builtins.c native_try）。
  let box = try(() => { return json(str(r["body"])); });
  let perr = get(box, "err", null);
  if (perr != null) { return "error: sidecar returned non-JSON: " + substr(str(r["body"]), 0, 300) + " (" + str(perr) + ")"; }
  let j = get(box, "ok", null);
  if (j == null) { return "error: sidecar result is null"; }
  let errv = str(get(j, "error", ""));
  if (len(errv) > 0) { return "tool error [" + tool_name + "]: " + errv; }
  let outv = str(get(j, "result", ""));
  // 兜住 MCP 单帧 64KiB（bridge_mcp.c:54）：超了 snprintf 会截出非法 JSON，
  // 把整条 tool 结果变成协议错误。取 20000 是因为要留转义余量——极端情况下
  // 每个引号/反斜杠都会翻倍（20000*2 + 包装 < 65536），16000/40000 都不够稳。
  if (len(outv) > 20000) { outv = substr(outv, 0, 20000) + "\n[output cut at MCP frame limit; the part above is complete, no retry needed]"; }
  // 双保险：业务函数历史上把可读失败写成 `error: ...`。sidecar 已在统一
  // 出口规范化，这里再兜住非 builtin 工具，避免 agent-httpd 把它当协议
  // 错误(502)并吞掉正文 —— 模型会因此看不到「服务未启动/未知平台」而重试。
  if (substr(outv, 0, 6) == "error:") { outv = "tool error [" + tool_name + "]: " + substr(outv, 6); }
  return outv;
}

tool "echo", "Echo text back. req: text. Use only to confirm the tool bridge is alive.", {"text": "string"}, (p) => {
  return sidecar_tool("echo", stringify(p));
};

tool "calculator", "Evaluate basic arithmetic. req: expression. No variables or functions.", {"expression": "string"}, (p) => {
  return sidecar_tool("calculator", stringify(p));
};

tool "read-file", "Read a text file. rel-base=work/ req: path. Repo short name works (lume-a2a/README.md). Page with offset/limit. Never use to guess article paths.", {"path": "string", "offset": "int", "limit": "int"}, (p) => {
  return sidecar_tool("read-file", stringify(p));
};

tool "analyze-dir", "Recursively scan a directory, bounded report. rel-base=work/ req: dir. Repo short names resolve. Read-only; use for unfamiliar folders.", {"dir": "string", "ignore": "array", "maxFiles": "number"}, (p) => {
  return sidecar_tool("analyze-dir", stringify(p));
};

tool "analyze-code-dir", "Symbol skeleton + LSP diagnostics, falls back to analyze-dir. rel-base=work/ req: dir. Read-only. Never call to guess article project paths.", {"dir": "string", "maxFiles": "number", "depth": "number", "includeDiagnostics": "bool"}, (p) => {
  return sidecar_tool("analyze-code-dir", stringify(p));
};

tool "doc-library-search", "Full-text search in local Markdown library. req: q. Needs markdown-library :3300; if down, report it plainly, do not retry blindly.", {"q": "string", "check_broken": "bool"}, (p) => {
  return sidecar_tool("doc-library-search", stringify(p));
};

tool "photo-duplicates", "Find duplicate photos + library stats (read-only). Needs photo-library :3100; if down, report it plainly instead of retrying.", {"similar": "bool", "stats": "bool"}, (p) => {
