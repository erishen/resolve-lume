# resolve-lume 环境配置（复制为 .env 后按需填写：cp .env.example .env）
# 隐私约定：本文件【不含】任何真实个人标识/密钥/令牌——真实值只填在你本地
# 的 .env（已被 .gitignore 忽略，不会入库）。以 <...> 占位的项请替换为你自己的值。

# ================= LLM 网关（OpenAI 兼容 /chat/completions 端点） =================
# 模式说明：
#   - backend 容器读此值，宿主 llm-router 需经 host.docker.internal 访问；
#   - 宿主 sidecar（sidecar/start-host.sh）会显式覆盖为 http://127.0.0.1:19070/v1/chat/completions，
#     直连宿主 llm-router，不受本值影响。
# 留空 LLM_API_KEY 时 agent-httpd 自动回落内置 demo 引擎，可离线跑通整条 SSE 链路。
# 真实部署里 LLM_API_URL 指向宿主 tsm-hub 网关（:19070），下面的模型名均为
# tsm-hub 的 route 别名；本例用 openai 占位，仅示意格式。
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
# 默认选中项：与免费项一致 => 下拉框默认停在「免费」。
LLM_MODEL=chat
# 单轮模型调用总预算（秒）。默认 60 在免费池上会在「工具输出很大」的那轮顶满：
# article-discover 成功后的一轮实测报 upstream timeout，工具结果白跑。这里放到 120。
LLM_TIMEOUT=120

# ---- 免费/付费模型开关（UI 下拉框来源）----
# 两个模型名都发给同一个 llm-router 网关（按模型名路由、共用一把 key）。
# 前端下拉框「免费 / 付费」直接对应这两个值；不选时回落到上面的 LLM_MODEL。
# 换网关词汇时改这两个，不必改代码。
# 免费=free-chat-zh（tsm-hub 严格免费 route：siliconflow/glm/modelscope 中文小模型）；
# 付费=deepseek-v4-flash（DeepSeek，按次计费）。
LLM_FREE_MODEL=free-chat-zh
LLM_PAID_MODEL=deepseek-v4-flash
# 最小模型白名单（逗号/空格分隔）：聊天 UI 仅允许下发这两个名；留空=不限制。
# 仅 C 后端校验「前端 override」，LLM_MODEL 兜底不受限。
LLM_ALLOWED_MODELS=chat,deepseek-v4-flash
# 可选：限制聊天 UI 能下发的模型名白名单（逗号/空格分隔）。留空=不限制
# （由上游网关负责校验合法名）。设置后，UI 选中的模型必须列在其中才会被
# backend 接受，否则忽略、回落 LLM_MODEL。建议生产环境填上 free+paid 两个。
# LLM_ALLOWED_MODELS=agnes-2.0-flash,deepseek-v4-flash

# PSE 三角色编排：改由前端「🧩 PSE」开关控制（sidecar 决定走
# /react/api/pse 还是 /react/api/chat），compose 已把容器的 PSE_ENABLED 固定为
# false，本项保留仅作说明，不再生效。
# PSE_ENABLED=true

# 额外注入到系统提示的内容（可选）
# LLM_SYSTEM_EXTRA=

# frontend(容器) ↔ sidecar(宿主) 的共享 token：前端反代时经 X-Sidecar-Token 注入，
# sidecar 从本 .env 读同一值校验。虽然只保护 loopback，sidecar 能读写宿主文件并
# 执行 shell，所以【必填且必须用随机值】：留空时 frontend / sidecar / compose
# 都会拒绝启动（fail-closed），源码里不再提供任何默认值。
# 生成：openssl rand -hex 32
# 改了这个值需同时重启 frontend 容器、backend 容器与宿主 sidecar（三者必须同值）；
# launcher :3099 每次控制请求都重读本文件，无需重启。
SIDECAR_TOKEN=

# 高危工具（shell/make/写盘/发布）在对话里调用时，把 approval-request 推进 chat SSE
# 等用户点 Approve；超时按拒绝，无活跃会话也拒绝。默认 120s。
# SIDECAR_APPROVAL_TIMEOUT_MS=120000

# ================= sidecar 工具代理（backend 里的 agent 反向调用业务工具） =================
# backend 容器里的 agent-httpd 通过 lume-tools/sidecar_ro.lume 这层 stdio MCP 代理，
# 反过来调用宿主 sidecar 的业务工具（read-file / dev-stats / hot-news …）。
# SIDECAR_TOOLS_AUTH 由 compose 取上面 SIDECAR_TOKEN 的同值，不用单独配；变量名避开
# *_TOKEN 是因为 lume 的 env() 会屏蔽含 TOKEN/SECRET/API_KEY/PASSWORD 的名字。
# 只有 sidecar 不在 3000 端口、或要换调用端点时才覆盖这一行：
# SIDECAR_TOOLS_URL=http://host.docker.internal:3000/api/tools/call
# 工具清单变化别手改 .lume，跑 `make tools-lume` 从 sidecar/builtin-tools.json 重新生成。

# ================= 业务工具路径（全部可选；不配 = 工具返回「未配置 XX」指引） =================
# 宿主模式：sidecar 直接跑在宿主机上，DIR 值一律填【宿主绝对路径】，
# 工具直接读写宿主真实文件（无容器挂载语义）。<you> 换成你的宿主用户名，
# <workspace> 换成你的工作区根目录名（本仓私有工作区根名不进公开仓）。

# --- PSE 框架（工作区 frameworks/ 下，各框架自带 macOS .venv） ---
# AUTOGEN_PSE_DIR=/Users/<you>/<workspace>/frameworks/autogen-pse
# CREWAI_PSE_DIR=/Users/<you>/<workspace>/frameworks/crewai-pse
# LANGGRAPH_PSE_DIR=/Users/<you>/<workspace>/frameworks/langgraph-pse
# LLAMAINDEX_PSE_DIR=/Users/<you>/<workspace>/frameworks/llamaindex-pse

# --- 敏感目录（站点凭据 / 投资数据；宿主模式直接可读写，属你的显式选择） ---
# WORDPRESS_TOOLS_DIR=/Users/<you>/<workspace>/personal/<site>/wordpress-tools
# ASSET_LENS_DIR=/Users/<you>/<workspace>/<tools>/apps/asset-lens
# LANGGRAPH_CSV_ANALYST_DIR=/Users/<you>/<workspace>/<tools>/apps/langgraph-csv-analyst
# PRODUCT_ANALYST_DIR=/Users/<you>/<workspace>/<tools>/apps/crewai-product-analyst

# --- 已在 work/ 内的项目 ---
# DEV_STATS_DIR=/Users/<you>/<workspace>/work/python/dev-stats
# DEV_STATS_USER=<your-github-username>
# DEV_STATS_PREVIEW_BASE_URL=http://127.0.0.1:18085

# --- 自建 HTTP 服务（宿主上跑的服务；宿主 sidecar 直连 127.0.0.1） ---
# MARKDOWN_LIBRARY_URL=http://127.0.0.1:3300
# MARKDOWN_LIBRARY_DIR=/Users/<you>/<workspace>/work/rust/markdown-library
# MARKDOWN_LIBRARY_KEY=
# PHOTO_LIBRARY_URL=http://127.0.0.1:3100
# PHOTO_LIBRARY_DIR=/Users/<you>/<workspace>/work/rust/photo-library
# PHOTO_LIBRARY_KEY=
# VIDEO_LIBRARY_URL=http://127.0.0.1:3200
# VIDEO_LIBRARY_DIR=/Users/<you>/<workspace>/work/rust/video-library
# VIDEO_LIBRARY_KEY=

# --- 外部账号 / 浏览器（公开信息可填，密钥只放本地 .env） ---
# ERISHEN_BASE=https://erishen.cn   # 公开的个人站点（WordPress），用于 pick-post 等
# CDP_URL=http://127.0.0.1:9222     # browser-desk 共享浏览器的 DevTools 端点

# ================= A2A peer 面（宿主 peer_node.lume，供 lume-a2a 集群调用） =================
# peer_node.lume 起一个宿主 lume 节点，暴露 resolve.*（只读目录）与 exec.*
# （把活递给 sidecar /api/jobs）。a2a 的 task.delegate 经 fleet 调到这里。
# PEER_ROOT 必须与全集群（a2a/crm/scanner/lan/talentlens）一致，否则验签失败。
# PEER_NAME=resolve-lume
# PEER_ROOT=verify-root-2026
# PEER_BIND=127.0.0.1
# PEER_PORT=18114

# 工具面裁剪（逗号分隔，按 <serverId>__<toolName> 精确匹配；留空=不裁剪）。
# 默认裁掉 git 的 19 个副作用型工具，保留 status/diff/log/show/blame/branch/
# remote/add/commit；被裁掉的能力仍可经 shell（人工审批）执行。
# MCP_TOOL_DENY='git__git_changelog_analyze,git__git_checkout,git__git_cherry_pick,git__git_clean,git__git_clear_working_dir,git__git_clone,git__git_fetch,git__git_init,git__git_merge,git__git_pull,git__git_push,git__git_rebase,git__git_reflog,git__git_reset,git__git_set_working_dir,git__git_stash,git__git_tag,git__git_worktree,git__git_wrapup_instructions'
